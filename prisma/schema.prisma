generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vehicles     Vehicle[]
  settings     Settings[]
}

model Vehicle {
  id                  String            @id @default(uuid())
  userId              String?
  name                String
  make                String
  model               String
  year                Int
  batteryCapacityKwh  Float
  initialOdometerKm   Float             @default(0)
  currentOdometerKm   Float             @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargingSessions    ChargingSession[]
  expenses            Expense[]
  trips               Trip[]
}

model ChargingProvider {
  id                  String            @id @default(uuid())
  name                String            @unique
  type                String            @default("PUBLIC") // HOME, PUBLIC, WORK, FAST_CHARGER
  pricePerKwhDefault  Float?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  chargingSessions    ChargingSession[]
}

model ChargingSession {
  id                  String            @id @default(uuid())
  vehicleId           String
  providerId          String?
  date                DateTime
  energyChargedKwh    Float
  cost                Float
  pricePerKwh         Float
  startBatteryPct     Float?
  endBatteryPct       Float?
  chargingType        String            @default("AC") // AC or DC
  odometerKm          Float?
  location            String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider            ChargingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model Expense {
  id                  String            @id @default(uuid())
  vehicleId           String
  date                DateTime
  category            String            // MAINTENANCE, INSURANCE, TAX, PARKING, ACCESSORY, OTHER
  amount              Float
  title               String
  description         String?
  odometerKm          Float?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Trip {
  id                  String            @id @default(uuid())
  vehicleId           String
  date                DateTime
  distanceKm          Float
  startOdometerKm     Float?
  endOdometerKm       Float?
  energyUsedKwh       Float?
  avgSpeedKmh         Float?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Settings {
  id                               String   @id @default("default")
  userId                           String?
  currencySymbol                   String   @default("$")
  defaultFuelPricePerL             Float    @default(1.85) // ICE comparison baseline
  defaultFuelConsumptionPer100km  Float    @default(7.5)  // ICE l/100km baseline
  language                         String   @default("en") // "en" | "tr"
  activeVehicleId                  String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  user                             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
